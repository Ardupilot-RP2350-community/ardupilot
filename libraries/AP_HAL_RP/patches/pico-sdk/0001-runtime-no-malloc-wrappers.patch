From dd1f0c30c29d79eeb25115faf51e6de3ebc9b912 Mon Sep 17 00:00:00 2001
From: Petro Shevchenko <shevchenko.p.i@gmail.com>
Date: Thu, 26 Mar 2026 20:43:47 +0200
Subject: [PATCH] runtime no malloc wrappers

---
 src/rp2_common/pico_runtime/CMakeLists.txt | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/rp2_common/pico_runtime/CMakeLists.txt b/src/rp2_common/pico_runtime/CMakeLists.txt
index e190d51..ce4398b 100644
--- a/src/rp2_common/pico_runtime/CMakeLists.txt
+++ b/src/rp2_common/pico_runtime/CMakeLists.txt
@@ -18,6 +18,11 @@ if (TARGET hardware_riscv_headers)
     target_link_libraries(pico_runtime INTERFACE hardware_riscv_headers)
 endif()
 
+# Optional: disable pico malloc/new-delete wrappers to avoid symbol conflicts
+option(PICO_RUNTIME_NO_MALLOC_WRAPPERS
+       "Exclude pico_malloc and pico_cxx_options from pico_runtime"
+       OFF)
+
 set(PICO_RUNTIME_LIBRARIES
         hardware_uart
         pico_bit_ops
@@ -39,6 +44,11 @@ set(PICO_RUNTIME_LIBRARIES
 )
 
 foreach(LIB IN LISTS PICO_RUNTIME_LIBRARIES)
+    if (PICO_RUNTIME_NO_MALLOC_WRAPPERS AND
+        (LIB STREQUAL "pico_malloc" OR LIB STREQUAL "pico_cxx_options"))
+        continue()
+    endif()
+
     if (TARGET ${LIB})
         pico_mirrored_target_link_libraries(pico_runtime INTERFACE ${LIB})
     endif()
-- 
