# Add executable with source files
add_executable(${CMAKE_PROJECT_NAME}
    {source_list_str}
)

set_target_properties(${CMAKE_PROJECT_NAME} PROPERTIES SUFFIX ".elf")
set_target_properties(${CMAKE_PROJECT_NAME} PROPERTIES OUTPUT_NAME ${ARDUPILOT_OUTPUT_NAME})

if(NOT IS_BOOTLOADER)
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE AP_HAL_RP)
endif()

target_link_options(${CMAKE_PROJECT_NAME} PRIVATE
    "LINKER:--allow-multiple-definition"
    "LINKER:--gc-sections"
)

set(AP_MEMMAP_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/application_memmap_default.ld")
set(AP_PICO_FLASH_REGION "${CMAKE_CURRENT_LIST_DIR}/application_pico_flash_region.ld")
if(WAF_BUILD_TARGET MATCHES "(^|/)bootloader($|/)")
    set(AP_MEMMAP_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/bootloader_memmap_default.ld")
    set(AP_PICO_FLASH_REGION "${CMAKE_CURRENT_LIST_DIR}/bootloader_pico_flash_region.ld")
endif()

if(NOT EXISTS "${AP_MEMMAP_SCRIPT}")
    message(FATAL_ERROR "Generated memmap script not found: ${AP_MEMMAP_SCRIPT}")
endif()
if(NOT EXISTS "${AP_PICO_FLASH_REGION}")
    message(FATAL_ERROR "Generated pico flash region file not found: ${AP_PICO_FLASH_REGION}")
endif()

set(AP_LINKER_SCRIPT "${AP_MEMMAP_SCRIPT}")

# Ensure GNU ld can resolve INCLUDEd scripts from CMAKE_CURRENT_LIST_DIR
# (for example application_pico_flash_region.ld / bootloader_pico_flash_region.ld).
if(COMMAND pico_set_linker_script)
    pico_set_linker_script(${CMAKE_PROJECT_NAME} "${AP_LINKER_SCRIPT}")
    target_link_options(${CMAKE_PROJECT_NAME} PRIVATE
        "LINKER:-L${CMAKE_CURRENT_LIST_DIR}"
    )
else()
    target_link_options(${CMAKE_PROJECT_NAME} PRIVATE
        "LINKER:-L${CMAKE_CURRENT_LIST_DIR}"
        "LINKER:-T${AP_LINKER_SCRIPT}"
    )
endif()
message(STATUS "Using linker script: ${AP_LINKER_SCRIPT}")
message(STATUS "Using pico flash region file: ${AP_PICO_FLASH_REGION}")

# Generate PIO headers

# Get a list of all .pio files in the pioasm directory
file(GLOB PIO_FILES "${CMAKE_CURRENT_LIST_DIR}/pioasm/*.pio")

if (NOT PIO_FILES)
    message(FATAL_ERROR "PIO_FILES NOT FOUND! Check path: ${CMAKE_CURRENT_SOURCE_DIR}/pioasm/*.pio")
else()
    message(STATUS "Found PIO files: ${PIO_FILES}")
endif()

find_program(PIOASM_PATH pioasm)

if(NOT PIOASM_PATH)
    set(PIOASM_PATH "${PICO_SDK_PATH}/tools/pioasm/build/pioasm")
endif()

# Iterate over the found files in a loop
foreach(PIO_FILE ${PIO_FILES})
    get_filename_component(PIO_NAME ${PIO_FILE} NAME_WE)
    set(OUTPUT_H "${CMAKE_CURRENT_BINARY_DIR}/generated/pico_base/${PIO_NAME}.pio.h")
    message(STATUS "Manually generating PIO header: ${OUTPUT_H}")

    execute_process(
        COMMAND ${PIOASM_PATH} ${PIO_FILE} ${OUTPUT_H}
        RESULT_VARIABLE PIO_RES
        ERROR_VARIABLE PIO_ERR
    )
    if (NOT PIO_RES EQUAL 0)
        message(FATAL_ERROR "pioasm failed for ${PIO_NAME}: ${PIO_ERR}")
    else()
        message(STATUS "Generated PIO header for: ${PIO_FILE}")
    endif()
endforeach()

message("PATH_TO_TARGET=${PATH_TO_TARGET}")
message("WAF_BUILD_TARGET=${WAF_BUILD_TARGET}")
message("ARDUPILOT_LIB=${ARDUPILOT_LIB}")
message("ARDUPILOT_BIN=${ARDUPILOT_BIN}")

string(REGEX MATCH "^(examples|tool)/" IS_EXAMPLE "${WAF_BUILD_TARGET}")

if (IS_EXAMPLE)
    string(REPLACE "/" ";" A ${WAF_BUILD_TARGET})
    list(GET A 0 EXAMPLE_BASE)
    list(GET A 1 EXAMPLE_NAME)
    message("Building ${EXAMPLE_BASE} ${EXAMPLE_NAME}")
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE "${ARDUPILOT_LIB}/${EXAMPLE_BASE}/lib${EXAMPLE_NAME}.a")
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE "${ARDUPILOT_LIB}/libap.a")
ELSEIF(${ARDUPILOT_CMD} STREQUAL "plane")
    message("Building for plane")
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE "${ARDUPILOT_BIN}/libarduplane.a")
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE "${ARDUPILOT_LIB}/libArduPlane_libs.a")
ELSEIF(${ARDUPILOT_CMD} STREQUAL "copter")
    message("Building for copter")
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE "${ARDUPILOT_BIN}/libarducopter.a")
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE "${ARDUPILOT_LIB}/libArduCopter_libs.a")
ELSEIF(${ARDUPILOT_CMD} STREQUAL "rover")
    message("Building for rover")
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE "${ARDUPILOT_BIN}/libardurover.a")
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE "${ARDUPILOT_LIB}/libRover_libs.a")
ELSEIF(${ARDUPILOT_CMD} STREQUAL "sub")
    message("Building for submarine")
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE "${ARDUPILOT_BIN}/libardusub.a")
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE "${ARDUPILOT_LIB}/libArduSub_libs.a")
ELSEIF(${ARDUPILOT_CMD} STREQUAL "bootloader")
    message("Building for bootloader")

    set(BOOTLOADER_LIBS)
    if(WAF_BUILD_TARGET MATCHES "^bootloader/")
        string(REPLACE "/" ";" BOOTLOADER_TARGET_PARTS "${WAF_BUILD_TARGET}")
        list(GET BOOTLOADER_TARGET_PARTS 1 BOOTLOADER_PROGRAM_NAME)
        list(APPEND BOOTLOADER_LIBS "${ARDUPILOT_LIB}/bootloader/lib${BOOTLOADER_PROGRAM_NAME}.a")
    elseif(EXISTS "${ARDUPILOT_LIB}/bootloader/libAP_Bootloader_RP.a")
        list(APPEND BOOTLOADER_LIBS "${ARDUPILOT_LIB}/bootloader/libAP_Bootloader_RP.a")
    elseif(EXISTS "${ARDUPILOT_LIB}/bootloader/libAP_Bootloader.a")
        list(APPEND BOOTLOADER_LIBS "${ARDUPILOT_LIB}/bootloader/libAP_Bootloader.a")
    else()
        file(GLOB BOOTLOADER_LIBS "${ARDUPILOT_LIB}/bootloader/lib*.a")
    endif()

    if(NOT BOOTLOADER_LIBS)
        message(FATAL_ERROR "No bootloader static libraries found in ${ARDUPILOT_LIB}/bootloader")
    endif()

    message("Bootloader archives: ${BOOTLOADER_LIBS}")
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE ${BOOTLOADER_LIBS})
    target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE
        pico_stdlib
        pico_multicore
        pico_stdio_usb
        hardware_spi
        hardware_i2c
        hardware_dma
        hardware_pio
        hardware_interp
        hardware_timer
        hardware_watchdog
        hardware_clocks
        hardware_flash
        hardware_powman
        hardware_adc
        FreeRTOS-Kernel
        FreeRTOS-Kernel-Heap4
        littlefs
    )
ENDIF()

add_custom_target(showinc ALL
        COMMAND echo
        "$<TARGET_PROPERTY:${CMAKE_PROJECT_NAME},INCLUDE_DIRECTORIES>"
        > includes.list
    VERBATIM
    BYPRODUCTS includes.list
    COMMAND_EXPAND_LISTS
)

# Add include directories
target_include_directories(${CMAKE_PROJECT_NAME} PRIVATE
    ${CMAKE_CURRENT_LIST_DIR}
    ${FREERTOS_KERNEL_PATH}/include
    ${FREERTOS_KERNEL_PATH}/portable/ThirdParty/Community-Supported-Ports/GCC/RP2350_ARM_NTZ/non_secure
)

# Enable USB stdio backend for optional USB CDC console support.
# UART stdio is disabled because AP_HAL_RP handles UART transport directly.
pico_enable_stdio_usb(${CMAKE_PROJECT_NAME} 1)
pico_enable_stdio_uart(${CMAKE_PROJECT_NAME} 0)

if(NOT IS_BOOTLOADER)
    # if we use bootloader and moved flash addresses, 
    # picotool converts elf to uf2 not correctly,
    # so we just disable convertion to uf2
    set(PICO_NO_UF2 1)
endif()

# Add the standard Pico build steps to create UF2
pico_add_extra_outputs(${CMAKE_PROJECT_NAME})
